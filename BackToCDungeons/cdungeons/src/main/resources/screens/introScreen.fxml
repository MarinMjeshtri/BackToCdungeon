<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<!--
    INTRO SCREEN — Back to CDungeons
    ─────────────────────────────────
    Cin.de Moni (Sindi sprite) appears on a dark screen and tells
    the opening story line by line using the same dialogue box system
    used in the rest of the game.

    Player presses SPACE, ENTER or clicks to advance each line.
    After the last line the screen fades to black and the game starts.

    Controller: introController.java
-->
<Pane fx:id="rootPane"
      prefHeight="720.0" prefWidth="1280.0"
      style="-fx-background-color: #000000;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.dungeons.Controllers.introController">

    <children>

        <!-- ── DARK ATMOSPHERIC BACKGROUND ───────────────────────── -->
        <!-- Subtle vignette feel via a slightly lighter centre -->
        <Pane prefWidth="1280" prefHeight="720"
              style="-fx-background-color: radial-gradient(center 50% 50%, radius 80%, #0a0a18, #000000);"
              mouseTransparent="true" />

        <!-- ── CIN.DE MONI FULL PORTRAIT ──────────────────────────
             Shown in the upper-left area.
             The image is loaded programmatically in introController
             so this ImageView starts empty. -->
        <AnchorPane layoutX="60" layoutY="60"
                    prefWidth="380" prefHeight="390"
                    style="-fx-background-color: transparent;">
            <ImageView fx:id="narratorPortrait"
                       fitWidth="380" fitHeight="390"
                       preserveRatio="true"
                       pickOnBounds="false"
                       layoutX="0" layoutY="0" />
        </AnchorPane>

        <!-- ── TITLE (shown before first line appears) ───────────── -->
        <Label fx:id="titleLabel"
               layoutX="480" layoutY="140"
               prefWidth="700"
               textAlignment="CENTER"
               style="-fx-font-size: 42px;
                      -fx-text-fill: #ffffff;
                      -fx-effect: dropshadow(gaussian, #8888ff, 22, 0.8, 0, 0);
                      -fx-alignment: center;"
               text="BACK TO CDUNGEONS"
               wrapText="true" />

        <Label fx:id="subtitleLabel"
               layoutX="480" layoutY="210"
               prefWidth="700"
               textAlignment="CENTER"
               style="-fx-font-size: 18px;
                      -fx-text-fill: #6666aa;
                      -fx-alignment: center;"
               text="A story narrated by Cin.de Moni"
               wrapText="true" />

        <!-- ── DIALOGUE BOX (same style as in-game dialogue) ─────── -->
        <!-- Character portrait panel -->
        <AnchorPane fx:id="portraitBox"
                    layoutX="1037" layoutY="478"
                    prefWidth="222" prefHeight="211"
                    style="-fx-background-color: #e9f0ff;
                           -fx-border-color: #111f2d;
                           -fx-border-width: 3;">
            <ImageView fx:id="dialoguePortrait"
                       fitWidth="208" fitHeight="199"
                       layoutX="7" layoutY="9"
                       preserveRatio="true"
                       pickOnBounds="true" />
        </AnchorPane>

        <!-- Text panel -->
        <AnchorPane fx:id="textBox"
                    layoutX="20" layoutY="477"
                    prefWidth="998" prefHeight="215"
                    style="-fx-background-color: #e9f0ff;
                           -fx-border-color: #111f2d;
                           -fx-border-width: 3;">
            <children>
                <!-- Name bar -->
                <AnchorPane layoutX="0" layoutY="0"
                            prefWidth="280" prefHeight="39"
                            style="-fx-background-color: #111f2d;">
                    <Label fx:id="characterNameLabel"
                           layoutX="10" layoutY="4"
                           prefWidth="260" prefHeight="31"
                           style="-fx-text-fill: #e9f0ff;
                                  -fx-font-size: 15px;
                                  -fx-font-weight: bold;"
                           text="Cin.de Moni">
                        <font><Font size="18.0" /></font>
                    </Label>
                </AnchorPane>

                <!-- Dialogue text -->
                <Label fx:id="dialogueText"
                       layoutX="10" layoutY="48"
                       prefWidth="974" prefHeight="152"
                       style="-fx-text-fill: #1a1a2e;
                              -fx-font-size: 15px;"
                       text=""
                       textAlignment="LEFT"
                       wrapText="true" />
            </children>
        </AnchorPane>

        <!-- SPACE / CLICK hint -->
        <Label fx:id="continueHint"
               layoutX="860" layoutY="688"
               style="-fx-text-fill: #555588;
                      -fx-font-size: 13px;"
               text="SPACE / ENTER / CLICK to continue" />

        <!-- ── SKIP BUTTON ────────────────────────────────────────── -->
        <Button layoutX="1150" layoutY="680"
                prefWidth="100" prefHeight="30"
                onAction="#handleSkip"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #444466;
                       -fx-border-color: #333355;
                       -fx-border-width: 1;
                       -fx-font-size: 12px;
                       -fx-cursor: hand;"
                text="SKIP ▶" />

        <!-- ── FADE OVERLAY (black, fades in at the end) ─────────── -->
        <Pane fx:id="fadeOverlay"
              prefWidth="1280" prefHeight="720"
              style="-fx-background-color: black;"
              opacity="0"
              mouseTransparent="true" />

    </children>
</Pane>
