<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dungeons.Controllers.chestController">
    <children>
        <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: rgba(0,0,0,0.75);">
            <children>

                <!-- main panel -->
                <AnchorPane layoutX="474.0" layoutY="124.0" prefHeight="434.0" prefWidth="331.0" style="-fx-background-color: #e9f0ff; -fx-border-color: #111f2d; -fx-border-width: 3;">
                    <children>

                        <!-- dark header bar -->
                        <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="40.0" prefWidth="331.0" style="-fx-background-color: #111f2d;">
                            <children>
                                <Label layoutX="14.0" layoutY="8.0" text="CHEST" style="-fx-text-fill: #e9f0ff; -fx-font-weight: bold; -fx-font-size: 16px;" />
                                <Label layoutX="120.0" layoutY="10.0" text="PRESS ESC to close" style="-fx-text-fill: #e9f0ff; -fx-font-size: 11px;" />
                            </children>
                        </AnchorPane>

                        <!-- item name panel -->
                        <AnchorPane layoutX="13.0" layoutY="56.0" prefHeight="42.0" prefWidth="305.0" style="-fx-background-color: #111f2d; -fx-border-color: #e9f0ff; -fx-border-width: 1;">
                            <children>
                                <Label fx:id="itemName" alignment="CENTER" layoutX="3.0" layoutY="12.0" prefHeight="18.0" prefWidth="299.0" text="ITEMNAME" textAlignment="CENTER" wrapText="true" style="-fx-text-fill: #e9f0ff; -fx-font-weight: bold;" />
                            </children>
                        </AnchorPane>

                        <!-- image panel -->
                        <AnchorPane layoutX="22.0" layoutY="106.0" prefHeight="177.0" prefWidth="287.0" style="-fx-background-color: #111f2d; -fx-border-color: #e9f0ff; -fx-border-width: 1;">
                            <children>
                                <ImageView fx:id="img1" fitHeight="150.0" fitWidth="200.0" layoutX="49.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </AnchorPane>

                        <!-- stats panel -->
                        <AnchorPane layoutX="12.0" layoutY="294.0" prefHeight="42.0" prefWidth="305.0" style="-fx-background-color: #e9f0ff; -fx-border-color: #111f2d; -fx-border-width: 2;">
                            <children>
                                <Label fx:id="statsItem" alignment="CENTER" layoutX="9.0" prefHeight="42.0" prefWidth="287.0" text="buffs/debuffs" textAlignment="CENTER" textOverrun="CENTER_ELLIPSIS" wrapText="true" style="-fx-text-fill: #1a1a2e; -fx-font-weight: bold;" />
                            </children>
                        </AnchorPane>

                        <!-- description panel -->
                        <AnchorPane layoutX="12.0" layoutY="348.0" prefHeight="74.0" prefWidth="305.0" style="-fx-background-color: #e9f0ff; -fx-border-color: #111f2d; -fx-border-width: 2;">
                            <children>
                                <Label fx:id="descItem" alignment="CENTER" layoutX="3.0" layoutY="4.0" prefHeight="66.0" prefWidth="299.0" text="description" wrapText="true" style="-fx-text-fill: #1a1a2e;" />
                            </children>
                        </AnchorPane>

                    </children>
                </AnchorPane>

            </children>
        </AnchorPane>
    </children>
</StackPane>