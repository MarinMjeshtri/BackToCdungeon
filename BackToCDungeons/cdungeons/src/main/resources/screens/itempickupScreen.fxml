<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dungeons.Controllers.chestController">
    <children>
        <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: rgba(0,0,0,0.75);">
            <children>


        <!-- main panel -->
        <AnchorPane layoutX="474.0" layoutY="124.0" prefHeight="434.0" prefWidth="331.0" styleClass="dark-panel">
            <children>

                <!-- ESC hint -->
                <Label layoutX="95.0" layoutY="31.0" styleClass="hint-label" text="PRESS ESC to close screen" />

                <!-- item name panel -->
                <AnchorPane layoutX="13.0" layoutY="56.0" prefHeight="42.0" prefWidth="305.0" styleClass="inner-panel">
                    <children>
                        <Label fx:id="itemName" alignment="CENTER" layoutX="3.0" layoutY="12.0" prefHeight="18.0" prefWidth="299.0" styleClass="item-name" text="ITEMNAME" textAlignment="CENTER" wrapText="true" />
                    </children>
                </AnchorPane>

                <!-- image panel -->
                <AnchorPane layoutX="22.0" layoutY="106.0" prefHeight="177.0" prefWidth="287.0" styleClass="inner-panel">
                    <children>
                        <ImageView fx:id="img1" fitHeight="150.0" fitWidth="200.0" layoutX="49.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true" />
                    </children>
                </AnchorPane>

                <!-- stats panel -->
                <AnchorPane layoutX="12.0" layoutY="294.0" prefHeight="42.0" prefWidth="305.0" styleClass="inner-panel">
                    <children>
                        <Label fx:id="statsItem" alignment="CENTER" layoutX="9.0" prefHeight="42.0" prefWidth="287.0" styleClass="desc-label" text="buffs/debuffs" textAlignment="CENTER" textOverrun="CENTER_ELLIPSIS" wrapText="true" />
                    </children>
                </AnchorPane>

                <!-- description panel -->
                <AnchorPane layoutX="12.0" layoutY="348.0" prefHeight="74.0" prefWidth="305.0" styleClass="inner-panel">
                    <children>
                        <Label fx:id="descItem" alignment="CENTER" layoutX="3.0" layoutY="4.0" prefHeight="66.0" prefWidth="299.0" styleClass="desc-label" text="description" wrapText="true" />
                    </children>
                </AnchorPane>

            </children>
        </AnchorPane>
            </children>
        </AnchorPane>
    </children>
</StackPane>
