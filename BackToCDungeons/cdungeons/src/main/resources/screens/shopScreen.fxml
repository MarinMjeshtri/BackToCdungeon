<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dungeons.Controllers.shopController">
    <children>

        <AnchorPane maxHeight="720.0" maxWidth="1280.0" prefHeight="720.0" prefWidth="1280.0">
            <children>

                <!-- title -->
                <Label alignment="CENTER" layoutX="268.0" layoutY="59.0" prefHeight="70.0" prefWidth="742.0" text="SHOPPING AREA">
                    <font><Font size="48.0" /></font>
                </Label>

                <!-- row 1 -->
                <AnchorPane layoutX="350.0" layoutY="150.0" prefHeight="200.0" prefWidth="578.0" styleClass="dark-panel">
                    <children>

                        <!-- item 1 -->
                        <AnchorPane fx:id="card1" layoutX="14.0" layoutY="0.0" prefHeight="199.0" prefWidth="170.0" styleClass="inner-panel"
                                    userData="smallHealthPotion" onMouseClicked="#handleCardClick">
                            <children>
                                <Label fx:id="item1" alignment="CENTER" layoutX="11.0" layoutY="14.0" prefHeight="18.0" prefWidth="136.0" styleClass="item-name" text="ITEM1" style="-fx-text-fill: #a6cbff;" />
                                <ImageView fx:id="img1" fitHeight="116.0" fitWidth="136.0" layoutX="17.0" layoutY="49.0" pickOnBounds="true" preserveRatio="true" />
                                <Label fx:id="price1" alignment="CENTER" layoutX="14.0" layoutY="171.0" prefHeight="18.0" prefWidth="136.0" styleClass="price-label" text="PRICE" style="-fx-text-fill: #a6cbff;" />
                            </children>
                        </AnchorPane>

                        <!-- item 2 -->
                        <AnchorPane fx:id="card2" layoutX="204.0" layoutY="0.0" prefHeight="199.0" prefWidth="170.0" styleClass="inner-panel"
                                    userData="bigHealthPotion" onMouseClicked="#handleCardClick">
                            <children>
                                <Label fx:id="item2" alignment="CENTER" layoutX="11.0" layoutY="14.0" prefHeight="18.0" prefWidth="136.0" styleClass="item-name" text="ITEM2" style="-fx-text-fill: #a6cbff;" />
                                <ImageView fx:id="img2" fitHeight="116.0" fitWidth="136.0" layoutX="17.0" layoutY="48.0" pickOnBounds="true" preserveRatio="true" />
                                <Label fx:id="price2" alignment="CENTER" layoutX="17.0" layoutY="176.0" prefHeight="18.0" prefWidth="136.0" styleClass="price-label" text="PRICE" style="-fx-text-fill: #a6cbff;" />
                            </children>
                        </AnchorPane>

                        <!-- item 3 -->
                        <AnchorPane fx:id="card3" layoutX="393.0" layoutY="0.0" prefHeight="199.0" prefWidth="170.0" styleClass="inner-panel"
                                    userData="strPotion" onMouseClicked="#handleCardClick">
                            <children>
                                <Label fx:id="item3" alignment="CENTER" layoutX="17.0" layoutY="14.0" prefHeight="18.0" prefWidth="136.0" styleClass="item-name" text="ITEM3" style="-fx-text-fill: #a6cbff;" />
                                <ImageView fx:id="img3" fitHeight="116.0" fitWidth="136.0" layoutX="17.0" layoutY="54.0" pickOnBounds="true" preserveRatio="true" />
                                <Label fx:id="price3" alignment="CENTER" layoutX="17.0" layoutY="176.0" prefHeight="18.0" prefWidth="136.0" styleClass="price-label" text="PRICE" style="-fx-text-fill: #a6cbff;" />
                            </children>
                        </AnchorPane>

                    </children>
                </AnchorPane>

                <!-- description panel -->
                <AnchorPane layoutX="350.0" layoutY="365.0" prefHeight="50.0" prefWidth="578.0" styleClass="dark-panel">
                    <children>
                        <Label fx:id="descLabel" alignment="CENTER" layoutX="10.0" layoutY="10.0"
                               prefHeight="30.0" prefWidth="558.0" text="Select an item to see its description." style="-fx-text-fill: #a6cbff;" />
                    </children>
                </AnchorPane>

                <!-- row 2 -->
                <AnchorPane layoutX="350.0" layoutY="430.0" prefHeight="200.0" prefWidth="578.0" styleClass="dark-panel">
                    <children>

                        <!-- item 4 -->
                        <AnchorPane fx:id="card4" layoutX="14.0" layoutY="0.0" prefHeight="199.0" prefWidth="170.0" styleClass="inner-panel"
                                    userData="" onMouseClicked="#handleCardClick">
                            <children>
                                <Label fx:id="item4" alignment="CENTER" layoutX="11.0" layoutY="14.0" prefHeight="18.0" prefWidth="136.0" styleClass="item-name" text="ITEM4" style="-fx-text-fill: #a6cbff;" />
                                <ImageView fx:id="img4" fitHeight="116.0" fitWidth="136.0" layoutX="17.0" layoutY="49.0" pickOnBounds="true" preserveRatio="true" />
                                <Label fx:id="price4" alignment="CENTER" layoutX="14.0" layoutY="171.0" prefHeight="18.0" prefWidth="136.0" styleClass="price-label" text="PRICE" style="-fx-text-fill: #a6cbff;" />
                            </children>
                        </AnchorPane>

                        <!-- item 5 -->
                        <AnchorPane fx:id="card5" layoutX="204.0" layoutY="0.0" prefHeight="199.0" prefWidth="170.0" styleClass="inner-panel"
                                    userData="" onMouseClicked="#handleCardClick">
                            <children>
                                <Label fx:id="item5" alignment="CENTER" layoutX="11.0" layoutY="14.0" prefHeight="18.0" prefWidth="136.0" styleClass="item-name" text="ITEM5" style="-fx-text-fill: #a6cbff;" />
                                <ImageView fx:id="img5" fitHeight="116.0" fitWidth="136.0" layoutX="17.0" layoutY="48.0" pickOnBounds="true" preserveRatio="true" />
                                <Label fx:id="price5" alignment="CENTER" layoutX="17.0" layoutY="176.0" prefHeight="18.0" prefWidth="136.0" styleClass="price-label" text="PRICE" style="-fx-text-fill: #a6cbff;" />
                            </children>
                        </AnchorPane>

                        <!-- item 6 -->
                        <AnchorPane fx:id="card6" layoutX="393.0" layoutY="0.0" prefHeight="199.0" prefWidth="170.0" styleClass="inner-panel"
                                    userData="" onMouseClicked="#handleCardClick">
                            <children>
                                <Label fx:id="item6" alignment="CENTER" layoutX="17.0" layoutY="14.0" prefHeight="18.0" prefWidth="136.0" styleClass="item-name" text="ITEM6" style="-fx-text-fill: #a6cbff;" />
                                <ImageView fx:id="img6" fitHeight="116.0" fitWidth="136.0" layoutX="17.0" layoutY="54.0" pickOnBounds="true" preserveRatio="true" />
                                <Label fx:id="price6" alignment="CENTER" layoutX="17.0" layoutY="176.0" prefHeight="18.0" prefWidth="136.0" styleClass="price-label" text="PRICE" style="-fx-text-fill: #a6cbff;" />
                            </children>
                        </AnchorPane>

                    </children>
                </AnchorPane>

                <!-- purchase button -->
                <AnchorPane layoutX="501.0" layoutY="648.0" prefHeight="64.0" prefWidth="277.0" styleClass="dark-panel">
                    <children>
                        <Button fx:id="purchaseBtn" onAction="#handlePurchase" layoutX="64.0" layoutY="7.0"
                                mnemonicParsing="false" prefHeight="50.0" prefWidth="151.0"
                                styleClass="button" text="PURCHASE" />
                    </children>
                </AnchorPane>

            </children>
        </AnchorPane>
    </children>
</StackPane>