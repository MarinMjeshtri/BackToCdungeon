<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #0a0a1a; -fx-min-height: 720; -fx-min-width: 1280;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dungeons.Controllers.tutorialController">

    <children>

        <!-- TITLE -->
        <Label layoutX="256.0" layoutY="30.0" prefWidth="800" style="-fx-font-size: 44px; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, #6666ff, 15, 0.7, 0, 0); -fx-alignment: center; -fx-text-alignment: center;" text="HOW TO PLAY">
            <font><Font size="18.0" /></font>
        </Label>

        <!-- NARRATOR HEADER BOX -->
        <Pane layoutX="60.0" layoutY="88.0" prefWidth="1160.0" prefHeight="130.0"
              style="-fx-background-color: #101030; -fx-border-color: #2222aa; -fx-border-width: 0 0 2 0; -fx-padding: 12;">

            <Label layoutX="16" layoutY="10" style="-fx-text-fill: #aa88ff; -fx-font-size: 15px; -fx-font-weight: bold;" text="CIN DE MONI  —  Narrator" />

            <Label layoutX="16" layoutY="38" prefWidth="1128" wrapText="true"
                style="-fx-text-fill: #c8c4ff; -fx-font-size: 13px; -fx-font-style: italic;"
                text="&quot;Ah, there you are. I am Cin de Moni — your narrator, your guide, and the only voice standing between you and an embarrassing early death. Listen carefully, because I will explain everything once, and the dungeon most certainly will not.&quot;" />

        </Pane>

        <!-- SCROLL AREA -->
        <ScrollPane fx:id="tutorialScroll" fitToWidth="true" hbarPolicy="NEVER"
            layoutX="60.0" layoutY="232.0" prefHeight="410.0" prefWidth="1160.0"
            style="-fx-background: #0a0a1a; -fx-background-color: #0a0a1a; -fx-border-color: #4444aa; -fx-border-width: 2;"
            vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="14" style="-fx-padding: 22; -fx-background-color: #0a0a1a;">

                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 18px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="GOAL" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni:  &quot;Your objective is simple enough to explain, and brutally difficult to actually do. Explore the dungeon, defeat every boss, and survive long enough to face SuperCoolSigma. Beat him, uncover the truth about the laboratory, and you win. Try not to die. I say try because... well. You will see.&quot;" />

                    <Label style="-fx-text-fill: #333388;" text="__________________________________________________________" />

                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 18px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="MOVEMENT" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni:  &quot;Moving yourself through a dungeon. This, at least, is the easy part — though I have watched enough adventurers walk directly into walls to know I should not assume. W A S D or the ARROW KEYS will get you where you are going.&quot;" />
                    <Label prefWidth="1080" style="-fx-text-fill: #8888bb; -fx-font-size: 13px;" wrapText="true"
                        text="  W / Up Arrow  =  Move Up          S / Down Arrow  =  Move Down          A / Left Arrow  =  Move Left          D / Right Arrow  =  Move Right          ESC  =  Pause the game" />

                    <Label style="-fx-text-fill: #333388;" text="__________________________________________________________" />

                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 18px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="COMBAT" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni:  &quot;Walk into a boss room and combat begins — automatically, dramatically, with no way to pretend you wandered in by accident. Combat is turn-based. You act. They act. Choose wisely each round.&quot;" />
                    <Label prefWidth="1080" style="-fx-text-fill: #8888bb; -fx-font-size: 13px;" wrapText="true"
                        text="  MOVE 1 / MOVE 2  =  Attack using your two main abilities          ITEM  =  Use a healing item from your inventory          UTILITY  =  Special ability (clone, wall, turret...)          DEFEND  =  Reduce damage taken this round" />

                    <Label style="-fx-text-fill: #333388;" text="__________________________________________________________" />

                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 18px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="ITEMS" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni:  &quot;The dungeon leaves things lying about for you. Chests are scattered throughout — press E near one and you may find something useful inside. Items restore health in combat. They are limited. Use them wisely. Or do not, and run out at the worst possible moment. I am a narrator, not your keeper.&quot;" />

                    <Label style="-fx-text-fill: #333388;" text="__________________________________________________________" />

                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 18px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="SHOP" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni:  &quot;Somewhere in this dungeon, a very tired Merchant is waiting for you. He has items and upgrades. Press E to interact. Stock up before the difficult bosses. He will tell you things worth hearing — even if the delivery is somewhat dramatic.&quot;" />

                    <Label style="-fx-text-fill: #333388;" text="__________________________________________________________" />

                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 18px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="BOSSES" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni:  &quot;These are not random creatures. These were people. The laboratory changed them, and the dungeon keeps them. Learn their patterns — do not simply swing wildly and hope. That strategy has a poor track record down here.&quot;" />
                    <Label prefWidth="1080" style="-fx-text-fill: #8888bb; -fx-font-size: 13px;" wrapText="true"
                        text="  JohnMKati      Clone abilities. He multiplies. Attack him while he monologues — it is the only way.&#10;  CassieYarn     Walls and Turrets. Relentless enthusiasm. Keep moving at all times.&#10;  FrekiRelah     Lightning strikes. Very few words. Both equally dangerous.&#10;  SuperCoolSigma The final boss. Everything ends here." />

                    <Label style="-fx-text-fill: #333388;" text="__________________________________________________________" />

                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 18px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="MUSIC" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni:  &quot;The music knows things the walls do not say. Exploration, combat, the final boss, the ending — each has its own voice. Listen carefully. The story is not only in the words.&quot;" />

                    <Label style="-fx-text-fill: #333388;" text="__________________________________________________________" />

                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 18px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="TIPS FROM CIN DE MONI" />
                    <Label prefWidth="1080" style="-fx-text-fill: #8888bb; -fx-font-size: 13px;" wrapText="true"
                        text="  - Save healing items for the final boss — you will need them more than you think&#10;  - Utility abilities can completely change a fight — use them with intention&#10;  - Explore every room — the chests do not find themselves&#10;  - Talk to the Merchant — tired, but extremely informative&#10;  - Pay attention to the dialogues — they contain hints about boss weaknesses&#10;  - If you die, you restart from the beginning. The dungeon does not forgive. Neither do I." />

                    <Label style="-fx-text-fill: #333388;" text="__________________________________________________________" />

                    <Label prefWidth="1080" style="-fx-text-fill: #44ffaa; -fx-font-size: 14px; -fx-effect: dropshadow(gaussian,#44ffaa,8,0.5,0,0); -fx-padding: 10 0 10 0; -fx-font-style: italic;"
                        text="Good luck, adventurer.  — Cin de Moni" textAlignment="CENTER" wrapText="true" />

                </VBox>
            </content>
        </ScrollPane>

        <!-- BACK BUTTON -->
        <Button layoutX="506.0" layoutY="655.0" onAction="#handleBack" prefHeight="46.0" prefWidth="268.0"
            style="-fx-background-color: #16213e; -fx-text-fill: white; -fx-border-color: #4444cc; -fx-border-width: 2; -fx-font-size: 14px; -fx-cursor: hand;"
            text="BACK" />

    </children>
</Pane>
