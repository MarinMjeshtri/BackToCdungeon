<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #0a0a1a; -fx-min-height: 720; -fx-min-width: 1280;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dungeons.Controllers.tutorialController">

    <children>

        <!-- TITLE -->
        <Label layoutX="0" layoutY="30.0" prefWidth="1280" style="-fx-font-size: 44px; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, #6666ff, 18, 0.8, 0, 0); -fx-alignment: center; -fx-text-alignment: center;" text="HOW TO PLAY" />

        <!-- NARRATOR SECTION: Cin de Moni portrait + intro speech bubble -->
        <HBox layoutX="60" layoutY="95" spacing="24" alignment="CENTER_LEFT">

            <!-- Portrait frame -->
            <VBox alignment="CENTER" spacing="6">
                <Pane prefWidth="160" prefHeight="180" style="-fx-background-color: #12122a; -fx-border-color: #6655cc; -fx-border-width: 3; -fx-effect: dropshadow(gaussian, #5544bb, 18, 0.7, 0, 0);">
                    <ImageView layoutX="4" layoutY="4" fitWidth="152" fitHeight="172" preserveRatio="true">
                        <image>
                            <Image url="/sprites/DialougeSprites/SindiCharacterDialougeSprite-NBR.png" />
                        </image>
                    </ImageView>
                </Pane>
                <Label prefWidth="160" style="-fx-text-fill: #bbaaff; -fx-font-size: 13px; -fx-font-style: italic; -fx-alignment: center;" text="Cin de Moni" />
                <Label prefWidth="160" style="-fx-text-fill: #7766cc; -fx-font-size: 11px; -fx-alignment: center;" text="— your narrator —" />
            </VBox>

            <!-- Speech bubble -->
            <Pane prefWidth="940" prefHeight="150" style="-fx-background-color: #14143a; -fx-border-color: #5544bb; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, #3333aa, 10, 0.5, 0, 0);">
                <Label layoutX="20" layoutY="18" prefWidth="900" wrapText="true"
                    style="-fx-text-fill: #ddd8ff; -fx-font-size: 14px; -fx-line-spacing: 4;"
                    text="Ah, there you are. I am Cin de Moni — your narrator, your guide, and the only voice standing between you and an embarrassing early death. Listen carefully, because I will explain everything once, and the dungeon most certainly will not." />
            </Pane>

        </HBox>

        <!-- MAIN SCROLL AREA -->
        <ScrollPane fx:id="tutorialScroll" fitToWidth="true" hbarPolicy="NEVER"
            layoutX="60.0" layoutY="290.0" prefHeight="360.0" prefWidth="1160.0"
            style="-fx-background: #0a0a1a; -fx-background-color: #0a0a1a; -fx-border-color: #4444aa; -fx-border-width: 2;" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="14" style="-fx-padding: 22; -fx-background-color: #0a0a1a;">

                    <!-- GOAL -->
                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 19px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="🎯  GOAL" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni says:  &#34;Your objective is simple enough to explain, and brutally difficult to actually do. Explore the dungeon, defeat every boss you encounter, and survive long enough to face the final boss — SuperCoolSigma. Beat him, uncover the truth about the laboratory, and you win. Try not to die. I say try because... well. You will see.&#34;" />

                    <Label style="-fx-text-fill: #4444aa;" text="──────────────────────────────────────────────────────" />

                    <!-- MOVEMENT -->
                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 19px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="🕹️  MOVEMENT" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni says:  &#34;Moving yourself through a dungeon. This, at least, is the easy part — though I have watched enough adventurers walk directly into walls to know I should not assume. W A S D or the ARROW KEYS will get you where you are going. Or trying to go. Whether you arrive intact is up to you.&#34;" />
                    <Label prefWidth="1080" style="-fx-text-fill: #8888bb; -fx-font-size: 13px;" wrapText="true"
                        text="  W / ↑  →  Move Up          S / ↓  →  Move Down          A / ←  →  Move Left          D / →  →  Move Right          ESC  →  Pause the game" />

                    <Label style="-fx-text-fill: #4444aa;" text="──────────────────────────────────────────────────────" />

                    <!-- COMBAT -->
                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 19px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="⚔️  COMBAT" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni says:  &#34;Walk into a boss room, and combat begins — automatically, dramatically, and with no way to pretend you wandered in by accident. Combat is turn-based. You act. They act. You choose wisely or you do not. Choose: MOVE 1 or MOVE 2 to attack, ITEM to use something from your inventory, UTILITY for a special ability, or DEFEND to absorb less punishment. Think carefully. The bosses certainly will not be polite about it.&#34;" />

                    <Label style="-fx-text-fill: #4444aa;" text="──────────────────────────────────────────────────────" />

                    <!-- ITEMS -->
                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 19px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="🧪  ITEMS" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni says:  &#34;The dungeon, to its credit, does leave things lying about for you. Chests are scattered throughout — press E near one and you may find something useful inside. Items restore your health during combat. They are limited. Use them wisely. Or do not, and run out at the worst possible moment. I am a narrator, not your keeper.&#34;" />

                    <Label style="-fx-text-fill: #4444aa;" text="──────────────────────────────────────────────────────" />

                    <!-- SHOP -->
                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 19px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="🛒  SHOP" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni says:  &#34;Somewhere in this dungeon, a very tired Merchant is waiting for you. He has items. He has upgrades. He also has opinions, but those are free and arguably less useful. Press E to interact. Stock up before the difficult bosses. He will tell you things about the people trying to destroy you, and those things are worth hearing — even if the delivery is somewhat dramatic.&#34;" />

                    <Label style="-fx-text-fill: #4444aa;" text="──────────────────────────────────────────────────────" />

                    <!-- BOSSES -->
                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 19px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="👾  BOSSES" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni says:  &#34;These are not random creatures. These are people. Or were. The laboratory changed them, and the dungeon keeps them. Learn their patterns — do not simply swing wildly and hope. That strategy has a poor track record down here.&#34;" />
                    <Label prefWidth="1080" style="-fx-text-fill: #8888bb; -fx-font-size: 13px;" wrapText="true"
                        text="  JohnMKati       →  Clone abilities. He will multiply. Do not ask why.&#10;  CassieYarn      →  Walls. Turrets. Relentless enthusiasm. Keep moving.&#10;  FrekiRelah      →  Lightning. Silence. Both equally dangerous.&#10;  SuperCoolSigma  →  The final boss. Everything ends here." />

                    <Label style="-fx-text-fill: #4444aa;" text="──────────────────────────────────────────────────────" />

                    <!-- MUSIC -->
                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 19px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="🎵  MUSIC" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni says:  &#34;The music knows things the walls do not say. Exploration, combat, the final boss, the ending — each has its own voice. Listen carefully. The story is not only in the words.&#34;" />

                    <Label style="-fx-text-fill: #4444aa;" text="──────────────────────────────────────────────────────" />

                    <!-- TIPS -->
                    <Label style="-fx-text-fill: #6666ff; -fx-font-size: 19px; -fx-effect: dropshadow(gaussian,#4444ff,6,0.5,0,0);" text="💡  TIPS FROM CIN DE MONI" />
                    <Label prefWidth="1080" style="-fx-text-fill: #aaaadd; -fx-font-size: 13px; -fx-font-style: italic;" wrapText="true"
                        text="Cin de Moni says:  &#34;A few parting observations, offered freely and completely without condescension:&#34;" />
                    <Label prefWidth="1080" style="-fx-text-fill: #8888bb; -fx-font-size: 13px;" wrapText="true"
                        text="  • Save your healing items for the final boss — you will need them more than you think&#10;  • Utility abilities can completely change a fight — use them with intention&#10;  • Explore every room. The chests do not find themselves&#10;  • Talk to the Merchant. They are very tired but extremely informative&#10;  • Pay attention to the dialogues — they contain hints about the bosses' weaknesses&#10;  • If you die, you restart from the beginning. The dungeon does not forgive. Neither does I." />

                    <Label style="-fx-text-fill: #4444aa;" text="──────────────────────────────────────────────────────" />

                    <Label prefWidth="1080" style="-fx-text-fill: #44ffaa; -fx-font-size: 15px; -fx-effect: dropshadow(gaussian,#44ffaa,8,0.5,0,0); -fx-padding: 10 0 10 0; -fx-font-style: italic;"
                        text="Good luck, adventurer. — Cin de Moni" textAlignment="CENTER" wrapText="true" />

                </VBox>
            </content>
        </ScrollPane>

        <!-- BACK BUTTON -->
        <Button layoutX="506.0" layoutY="668.0" onAction="#handleBack" prefHeight="42.0" prefWidth="268.0"
            style="-fx-background-color: #16213e; -fx-text-fill: white; -fx-border-color: #4444cc; -fx-border-width: 2; -fx-font-size: 14px; -fx-cursor: hand;"
            text="← BACK" />

    </children>
</Pane>
