                        <AnchorPane layoutX="16.0" layoutY="130.0" prefHeight="73.0" prefWidth="336.0" style="-fx-background-color: #e9f0ff; -fx-border-color: #111f2d; -fx-border-width: 2;">
                            <children>
                                <Label layoutX="14.0" layoutY="17.0" prefHeight="38.0" prefWidth="145.0" text="TOTAL XP GAINED :" style="-fx-text-fill: #1a1a2e; -fx-font-weight: bold." />
