                <Rectangle arcHeight="5.0" arcWidth="5.0" height="720.0" opacity="0.27" stroke="BLACK" strokeType="INSIDE" width="1280.0" />
                <AnchorPane layoutX="458.0" layoutY="114.0" prefHeight="478.0" prefWidth="364.0" style="-fx-background-color: #111f2d; -fx-border-color: #111f2d; -fx-border-width: 3;">
                    <children>
