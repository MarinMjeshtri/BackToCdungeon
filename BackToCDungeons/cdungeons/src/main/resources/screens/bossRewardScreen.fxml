<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rewardRoot" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dungeons.Controllers.BossRewardController">
    <children>
        <Rectangle height="720.0" opacity="0.62" stroke="BLACK" strokeType="INSIDE" width="1280.0" />
        <AnchorPane maxHeight="520.0" maxWidth="680.0" prefHeight="520.0" prefWidth="680.0" style="-fx-background-color: #111f2d; -fx-border-color: #eaf4ff; -fx-border-width: 3; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.75), 22, 0.35, 0, 6);">
            <children>
                <Label alignment="CENTER" layoutX="40.0" layoutY="28.0" prefHeight="54.0" prefWidth="600.0" style="-fx-text-fill: #eaf4ff; -fx-font-weight: bold;" text="CONGRATULATIONS">
                    <font>
                        <Font size="38.0" />
                    </font>
                </Label>
                <Label alignment="CENTER" layoutX="58.0" layoutY="82.0" prefHeight="34.0" prefWidth="564.0" style="-fx-text-fill: #9fd7ff; -fx-font-size: 15px;" text="The boss dropped two items." />

                <AnchorPane layoutX="48.0" layoutY="142.0" prefHeight="220.0" prefWidth="275.0" style="-fx-background-color: #e9f0ff; -fx-border-color: #9fd7ff; -fx-border-width: 2;">
                    <children>
                        <Rectangle height="92.0" layoutX="91.0" layoutY="20.0" stroke="#111f2d" strokeType="INSIDE" style="-fx-fill: #c8d3df;" width="92.0" />
                        <ImageView fx:id="itemImageOne" fitHeight="78.0" fitWidth="78.0" layoutX="98.0" layoutY="27.0" pickOnBounds="true" preserveRatio="true" smooth="false" />
                        <Label fx:id="itemNameOne" alignment="CENTER" layoutX="20.0" layoutY="124.0" prefHeight="30.0" prefWidth="235.0" style="-fx-text-fill: #111f2d; -fx-font-weight: bold; -fx-font-size: 16px;" text="ITEM ONE" />
                        <Label fx:id="itemDescOne" alignment="TOP_CENTER" layoutX="18.0" layoutY="158.0" prefHeight="48.0" prefWidth="239.0" style="-fx-text-fill: #1a1a2e; -fx-font-size: 11px;" text="Description" textAlignment="CENTER" wrapText="true" />
                    </children>
                </AnchorPane>

                <AnchorPane layoutX="357.0" layoutY="142.0" prefHeight="220.0" prefWidth="275.0" style="-fx-background-color: #e9f0ff; -fx-border-color: #9fd7ff; -fx-border-width: 2;">
                    <children>
                        <Rectangle height="92.0" layoutX="91.0" layoutY="20.0" stroke="#111f2d" strokeType="INSIDE" style="-fx-fill: #c8d3df;" width="92.0" />
                        <ImageView fx:id="itemImageTwo" fitHeight="78.0" fitWidth="78.0" layoutX="98.0" layoutY="27.0" pickOnBounds="true" preserveRatio="true" smooth="false" />
                        <Label fx:id="itemNameTwo" alignment="CENTER" layoutX="20.0" layoutY="124.0" prefHeight="30.0" prefWidth="235.0" style="-fx-text-fill: #111f2d; -fx-font-weight: bold; -fx-font-size: 16px;" text="ITEM TWO" />
                        <Label fx:id="itemDescTwo" alignment="TOP_CENTER" layoutX="18.0" layoutY="158.0" prefHeight="48.0" prefWidth="239.0" style="-fx-text-fill: #1a1a2e; -fx-font-size: 11px;" text="Description" textAlignment="CENTER" wrapText="true" />
                    </children>
                </AnchorPane>

                <Label fx:id="resultLabel" alignment="CENTER" layoutX="60.0" layoutY="380.0" prefHeight="30.0" prefWidth="560.0" style="-fx-text-fill: #eaf4ff; -fx-font-size: 13px;" text="Two boss spoils are ready for your hotbar." />
                <Button fx:id="claimButton" layoutX="222.0" layoutY="428.0" mnemonicParsing="false" onAction="#claimRewards" prefHeight="58.0" prefWidth="236.0" style="-fx-background-color: #2f3f86; -fx-text-fill: #eaf4ff; -fx-font-weight: bold; -fx-font-size: 18px; -fx-border-color: #b8c7ff; -fx-border-width: 2;" text="CLAIM" />
            </children>
        </AnchorPane>
    </children>
</StackPane>
