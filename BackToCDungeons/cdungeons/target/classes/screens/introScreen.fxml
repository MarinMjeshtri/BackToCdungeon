<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<Pane fx:id="rootPane" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #000000; -fx-min-height: 720; -fx-min-width: 1280;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dungeons.Controllers.introController">

    <children>

        <!--
            storyContainer holds all the story text lines.
            introController.java moves it from bottom to top using a Timeline animation.
            It starts below the screen and scrolls upward until fully gone,
            then the screen fades to black and the game launches.
        -->
        <VBox fx:id="storyContainer" layoutX="390.0" prefWidth="500" spacing="30">

            <!-- Top spacer — pushes text to start from below the screen -->
            <Label prefHeight="620" prefWidth="500" style="-fx-background-color: transparent;" text="" />

            <!-- TITLE -->
            <Label prefWidth="500" style="-fx-font-size: 28px; -fx-text-fill: #ffffff;                           -fx-effect: dropshadow(gaussian, #8888ff, 20, 0.8, 0, 0);                           -fx-alignment: center;" text="BACK TO CDUNGEONS" textAlignment="CENTER" wrapText="true" />

            <Label alignment="CENTER" prefWidth="500" style="-fx-font-size: 13px; -fx-text-fill: #555588;" text="─────────────────────────────────────────" textAlignment="CENTER" wrapText="true" />

            <!-- STORY LINES -->
            <Label prefWidth="500" style="-fx-font-size: 15px; -fx-text-fill: #c8c8ff; -fx-line-spacing: 5;" text="For many years, one of the most important laboratories in the world stood at the heart of human discovery. Scientists called it the crown jewel of modern research." textAlignment="CENTER" wrapText="true" />

            <Label prefWidth="500" style="-fx-font-size: 15px; -fx-text-fill: #c8c8ff; -fx-line-spacing: 5;" text="Until the day everyone now calls... The Explosion." textAlignment="CENTER" wrapText="true" />

            <Label prefWidth="500" style="-fx-font-size: 15px; -fx-text-fill: #aaaacc; -fx-line-spacing: 5;" text="No one knows what truly happened. The official reports were sealed within hours. Witnesses disappeared. Files were wiped." textAlignment="CENTER" wrapText="true" />

            <Label prefWidth="500" style="-fx-font-size: 15px; -fx-text-fill: #aaaacc; -fx-line-spacing: 5;" text="What is known is this: not a single person who entered that laboratory ever came back out." textAlignment="CENTER" wrapText="true" />

            <Label alignment="CENTER" prefWidth="500" style="-fx-font-size: 13px; -fx-text-fill: #555588;" text="─────────────────────────────────────────" textAlignment="CENTER" wrapText="true" />

            <Label prefWidth="500" style="-fx-font-size: 15px; -fx-text-fill: #c8c8ff; -fx-line-spacing: 5;" text="You are living an ordinary life. A quiet one. A job you do not love. A flat you do not hate. Tuesday afternoons that feel exactly like Monday mornings." textAlignment="CENTER" wrapText="true" />

            <Label prefWidth="500" style="-fx-font-size: 15px; -fx-text-fill: #c8c8ff; -fx-line-spacing: 5;" text="Until one day, by complete accident, your hand brushes against a strange object. Small. Cold. Humming faintly, like it has been waiting." textAlignment="CENTER" wrapText="true" />

            <Label prefWidth="500" style="-fx-font-size: 15px; -fx-text-fill: #ffffff; -fx-line-spacing: 5;                           -fx-effect: dropshadow(gaussian, #6666aa, 6, 0.4, 0, 0);" text="And in an instant — memories flood in. Memories that are not yours. A corridor. White walls. Screaming. A door sealing shut." textAlignment="CENTER" wrapText="true" />

            <Label prefWidth="500" style="-fx-font-size: 16px; -fx-text-fill: #aaaaff; -fx-line-spacing: 5;" text="Or... are they yours?" textAlignment="CENTER" wrapText="true" />

            <Label alignment="CENTER" prefWidth="500" style="-fx-font-size: 13px; -fx-text-fill: #555588;" text="─────────────────────────────────────────" textAlignment="CENTER" wrapText="true" />

            <Label prefWidth="500" style="-fx-font-size: 15px; -fx-text-fill: #aaaacc; -fx-line-spacing: 5;" text="The dungeon below the city holds the answers. It always has. Guarded by those who were there that night. Those who survived. Those who remember." textAlignment="CENTER" wrapText="true" />

            <Label prefWidth="500" style="-fx-font-size: 15px; -fx-text-fill: #aaaacc; -fx-line-spacing: 5;" text="And at the very bottom, in the ruins of the laboratory itself, something waits. Something that knows your name. Something that is, in a way you cannot yet explain..." textAlignment="CENTER" wrapText="true" />

            <Label prefWidth="500" style="-fx-font-size: 17px; -fx-text-fill: #ff8888;                           -fx-effect: dropshadow(gaussian, #ff4444, 10, 0.5, 0, 0);" text="you." textAlignment="CENTER" wrapText="true" />

            <Label alignment="CENTER" prefWidth="500" style="-fx-font-size: 13px; -fx-text-fill: #555588;" text="─────────────────────────────────────────" textAlignment="CENTER" wrapText="true" />

            <Label prefWidth="500" style="-fx-font-size: 15px; -fx-text-fill: #c8c8ff; -fx-line-spacing: 5;" text="The truth is waiting in the dungeon." textAlignment="CENTER" wrapText="true" />

            <Label prefWidth="500" style="-fx-font-size: 16px; -fx-text-fill: #44ffaa;                           -fx-effect: dropshadow(gaussian, #44ffaa, 8, 0.4, 0, 0);" text="Whether you are ready for it... is another question entirely." textAlignment="CENTER" wrapText="true" />

            <!-- Bottom spacer — gives the last line time to scroll fully off screen -->
            <Label prefHeight="650" prefWidth="500" style="-fx-background-color: transparent;" text="" />

        </VBox>

           <!-- Fade overlay — starts transparent, fades to black at the end -->
        <Pane fx:id="fadeOverlay" mouseTransparent="true" opacity="0" prefHeight="600" prefWidth="800" style="-fx-background-color: black;" />

        <!-- SKIP button — always visible -->
        <Button layoutX="1114.0" layoutY="626.0" onAction="#handleSkip" prefHeight="80.0" prefWidth="152.0" style="-fx-background-color: transparent;                        -fx-text-fill: #444466;                        -fx-border-color: #333355;                        -fx-border-width: 1;                        -fx-font-size: 12px;                        -fx-cursor: hand;" text="SKIP ▶" />

    </children>
</Pane>
